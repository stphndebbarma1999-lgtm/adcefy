# Supabase (safe to expose in the browser — protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never import from a Client Component.
# Used only in server actions / route handlers that must bypass RLS (e.g. admin writes).
SUPABASE_SERVICE_ROLE_KEY=

# Required to enable the /admin panel. Without this set, /admin login always
# fails closed (nobody can log in) rather than silently allowing access.
ADMIN_PASSWORD=

# Optional — used only to sign the admin session cookie. Falls back to
# ADMIN_PASSWORD if unset. Set a separate random value for stronger security.
ADMIN_SESSION_SECRET=
